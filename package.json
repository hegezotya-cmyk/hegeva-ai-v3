{
  "name": "hegeva-ai-v3",
  "version": "4.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrations:local": "wrangler d1 migrations apply hegeva-ai-db --local",
    "db:migrations:list:remote": "wrangler d1 migrations list hegeva-ai-db --remote",
    "db:migrate:remote": "wrangler d1 migrations apply hegeva-ai-db --remote",
    "worker:check": "node --check src/index-ledger.js && node --check src/index.js && node --check src/auth.js",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:api": "wrangler deploy",
    "deploy:ui": "npm --prefix v0-app run cf:deploy",
    "release:remote-state": "npm run db:migrations:list:remote",
    "release:check": "npm run worker:check && npm run db:migrations:local && npm run deploy:dry-run && npm --prefix v0-app exec tsc -- --noEmit && npm --prefix v0-app run build && npm --prefix v0-app run cf:build",
    "release:smoke": "node scripts/release-smoke.mjs",
    "v0:build": "npm --prefix v0-app run cf:build"
  },
  "dependencies": {
    "better-auth": "^1.7.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

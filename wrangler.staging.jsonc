{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3-staging",
  "main": "src/index-ledger.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "vars": {
    "PAYMENT_PROVIDER": "stripe",
    "PAYMENT_MODE": "test",
    "OUTBOX_PROCESSOR_ENABLED": "true",
    "PUBLIC_APP_URL": "https://staging.hegevaai.co.uk",
    "STRIPE_PREMIUM_PRICE_ID": "price_1UDa3fHECF9iDE3lyFzhEB3T",
    "STRIPE_PRO_PRICE_ID": "price_1UDa46HECF9iDE3lrC8m8Xge",
    "STRIPE_TOPUP_SMALL_PRICE_ID": "price_1UYJpOHECF9iDE3lOMUbVNwb",
    "STRIPE_TOPUP_MEDIUM_PRICE_ID": "price_1UYJqYHECF9iDE3lta3DI13x",
    "STRIPE_TOPUP_LARGE_PRICE_ID": "price_1UYJr9HECF9iDE3lxVxs0DuS",
    "STAGING_SECRETS_CONFIGURED": "confirmed",
    "AI_ADVANCED_ASSISTANT_CREDIT_COST": "8",
    "EMAIL_DELIVERY_ENABLED": "enabled",
    "EMAIL_DELIVERY_TEST_MODE_ENABLED": "enabled",
    "FINANCIAL_GUARD_ENABLED": "enabled"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hegeva-ai-staging-db",
      "database_id": "0a80696d-66ae-424a-a16b-ba00f91dcad9",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "UserRateLimiter" }]
  },
  "migrations": [{ "tag": "staging-v2-rate-limiter", "new_sqlite_classes": ["UserRateLimiter"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
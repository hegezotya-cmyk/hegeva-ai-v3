# Public (client-exposed) build-time configuration for production builds.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and
# are not secrets. This file is intentionally NOT in .gitignore
# (only .env*.local and .dev.vars* are ignored) so the value persists across
# every production build/deploy.
NEXT_PUBLIC_CLARITY_PROJECT_ID=yhwsx7syqf

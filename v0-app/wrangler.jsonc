{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3-v0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "hegevaai.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.hegevaai.co.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "HEGEVA_API",
      "service": "hegeva-ai-v3",
      "remote": true
    }
  ]
}

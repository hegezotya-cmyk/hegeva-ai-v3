{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "keep_vars": true,

  "vars": {
    "PAYMENT_PROVIDER": "stripe",
    "PAYMENT_MODE": "test",
    "PUBLIC_APP_URL": "https://hegevaai.co.uk",
    "STRIPE_PREMIUM_PRICE_ID": "price_1U4YwrHH1vUED8ZNhhfKfzNK",
    "STRIPE_PRO_PRICE_ID": "price_1U4YzOHH1vUED8ZNWbKbl3FH"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hegeva-ai-db",
      "database_id": "1aa89d03-3f5c-4505-814a-5c379148f22d",
      "migrations_dir": "./migrations"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}

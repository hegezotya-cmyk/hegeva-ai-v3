{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
    "not_found_handling": "single-page-application"
  }
}

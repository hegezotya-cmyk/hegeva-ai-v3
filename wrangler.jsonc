{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "keep_vars": true,

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hegeva-ai-db",
      "database_id": "1aa89d03-3f5c-4505-814a-5c379148f22d"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}

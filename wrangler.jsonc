{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hegeva-ai-v3",
  "main": "src/index-ledger.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },

  "vars": {
    "PAYMENT_PROVIDER": "stripe",
    "PAYMENT_MODE": "live",
    "PUBLIC_APP_URL": "https://hegevaai.co.uk",
    "STRIPE_PREMIUM_PRICE_ID": "price_1UBZJhHECF9iDE3lyMGzfYkL",
    "STRIPE_PRO_PRICE_ID": "price_1UBZJiHECF9iDE3lnpsGymgU",
    "AI_PROVIDER_ENABLED": "disabled",
    "AI_PROVIDER_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_MAX_INPUT_TOKENS": "200",
    "AI_MAX_OUTPUT_TOKENS": "100",
    "AI_TIMEOUT_MS": "10000",
    "AI_DAILY_REQUEST_CEILING": "1",
    "AI_DAILY_NEURON_CEILING": "7000",
    "AI_DOCUMENTED_DAILY_NEURON_ALLOCATION": "10000",
    "AI_PER_USER_CEILING": "1",
    "AI_PER_WORKSPACE_CEILING": "1",
    "AI_CONCURRENCY_CEILING": "1",
    "AI_GLOBAL_KILL_SWITCH": "enabled",
    "AI_BOT_CANARY_ENABLED": "disabled",
    "AI_BOT_CANARY_EMAIL": "hegezotya@gmx.com",
    "FINANCIAL_GUARD_ENABLED": "enabled"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hegeva-ai-db",
      "database_id": "1aa89d03-3f5c-4505-814a-5c379148f22d",
      "migrations_dir": "./migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "UserRateLimiter"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v2-rate-limiter",
      "new_sqlite_classes": ["UserRateLimiter"]
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
